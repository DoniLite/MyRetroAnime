---
import { type Lang, ui } from "../lib/i18n";

const { lang } = Astro.props as { lang: Lang };
---

<label class="spoiler-toggle" title={ui[lang].showSpoilers}>
	<input type="checkbox" role="switch" data-spoiler-toggle aria-label={ui[lang].showSpoilers} />
	<span class="track" aria-hidden="true"></span>
	<span class="text" aria-hidden="true">{ui[lang].spoilers}</span>
</label>

<script>
	const root = document.documentElement;
	for (const input of document.querySelectorAll<HTMLInputElement>("[data-spoiler-toggle]")) {
		input.checked = root.dataset.spoilers === "shown";
		input.addEventListener("change", () => {
			if (input.checked) root.dataset.spoilers = "shown";
			else delete root.dataset.spoilers;
			try {
				localStorage.setItem("spoilers", input.checked ? "shown" : "hidden");
			} catch {}
		});
	}
</script>

<style>
	.spoiler-toggle {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2rem;
		padding: 0 0.75rem 0 0.4rem;
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: rgb(255 255 255 / 0.75);
		cursor: pointer;
	}
	/* The native checkbox stays focusable and clickable, laid over the drawn switch. */
	input {
		position: absolute;
		inset: 0;
		margin: 0;
		opacity: 0;
		cursor: pointer;
	}
	.track {
		position: relative;
		width: 2rem;
		height: 1.1rem;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.18);
		transition: background 0.2s ease;
	}
	.track::after {
		content: "";
		position: absolute;
		top: 0.15rem;
		left: 0.15rem;
		width: 0.8rem;
		height: 0.8rem;
		border-radius: 50%;
		background: #fff;
		transition: transform 0.2s ease;
	}
	input:checked + .track {
		background: var(--accent);
	}
	input:checked + .track::after {
		transform: translateX(0.9rem);
	}
	input:focus-visible + .track {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	/* On a phone the switch alone is enough; its accessible name stays on the input. */
	@media (max-width: 30rem) {
		.text {
			display: none;
		}
		.spoiler-toggle {
			padding: 0 0.4rem;
		}
	}
</style>
