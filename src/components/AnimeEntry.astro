---
import { render } from "astro:content";
import type { Anime } from "../lib/anime";
import { type Lang, ui } from "../lib/i18n";
import { mediumPoster } from "../lib/poster";
import AnimeHeader from "./AnimeHeader.astro";
import Spoiler from "./mdx/Spoiler.astro";
import Trailer from "./Trailer.astro";

interface Props {
	anime: Anime;
	lang: Lang;
}

const { anime, lang } = Astro.props;
const { info, meta, text } = anime;
const t = ui[lang];
const rendered = text && (await render(text.entry));
const pitch = text?.entry.data.pitch;
// MAL's synopsis is English-only and long: tucked away, and never shown on French pages.
const synopsis = !pitch && lang === "en" ? info.synopsis : null;
const poster = info.image && mediumPoster(info.image);
---

<article class="anime-entry">
	<header class="hero" style={poster ? `--poster: url("${poster}")` : undefined}>
		{/* Lazy: every entry of the year sits in the page's dialog, hidden until opened. */}
		{poster && <img class="poster" src={poster} alt="" width="225" height="318" loading="lazy" fetchpriority="low" />}
		<div class="hero-text">
			<AnimeHeader anime={anime} lang={lang} as="h1" />
			{pitch && <p class="pitch" lang={text.lang}>{pitch}</p>}
			<a class="mal" href={`https://myanimelist.net/anime/${meta.malId}`} target="_blank" rel="noopener">MyAnimeList ↗</a>
		</div>
	</header>

	<div class="body">
		{text?.fallback && <p class="fallback muted">{t.notTranslated}</p>}
		{
			synopsis && (
				<details class="synopsis">
					<summary>{t.synopsis}</summary>
					<p>{synopsis}</p>
				</details>
			)
		}
		{info.trailerYoutubeId && <Trailer youtubeId={info.trailerYoutubeId} title={info.title} lang={lang} />}
		{
			meta.criteria.length > 0 && (
				<dl class="criteria">
					{meta.criteria.map((criterion) => (
						<div>
							<dt>{criterion.label[lang]}</dt>
							<dd>{criterion.score}/10</dd>
						</div>
					))}
				</dl>
			)
		}
		{rendered && <div class="prose" lang={text.lang}><rendered.Content components={{ Spoiler }} /></div>}
	</div>
</article>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		display: grid;
		grid-template-columns: 9.5rem 1fr;
		gap: 1.5rem;
		align-items: end;
		padding: 3.5rem 1.75rem 1.75rem;
		overflow: hidden;
	}
	/* The poster, blown up and blurred, becomes the backdrop; it fades into the page below. */
	.hero::before,
	.hero::after {
		content: "";
		position: absolute;
		z-index: -1;
	}
	.hero::before {
		inset: -3rem;
		background: var(--poster, none) center / cover;
		filter: blur(28px) saturate(1.4);
		opacity: 0.55;
	}
	.hero::after {
		inset: 0;
		background: linear-gradient(to bottom, rgb(0 0 0 / 0.1), var(--bg) 95%);
	}
	.poster {
		width: 100%;
		height: auto;
		border-radius: 10px;
		box-shadow:
			0 18px 40px rgb(0 0 0 / 0.5),
			0 0 0 1px rgb(255 255 255 / 0.08);
	}
	.hero-text :global(.title) {
		font-size: clamp(1.6rem, 4vw, 2.4rem);
		text-wrap: balance;
	}
	.pitch {
		margin: 0.9rem 0 0;
		font-size: 1.1rem;
	}
	.mal {
		display: inline-block;
		margin-top: 0.75rem;
		font-size: 0.85rem;
		color: var(--muted);
	}
	@media (max-width: 34rem) {
		.hero {
			grid-template-columns: 6.5rem 1fr;
			gap: 1rem;
			padding: 3.5rem 1.25rem 1.25rem;
		}
	}

	.body {
		display: grid;
		gap: 1.5rem;
		padding: 0 1.75rem 1.75rem;
	}
	@media (max-width: 34rem) {
		.body {
			padding: 0 1.25rem 1.25rem;
		}
	}
	.synopsis {
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 0.75rem 1rem;
		background: var(--surface);
	}
	.synopsis summary {
		cursor: pointer;
		font-weight: 600;
	}
	.synopsis p {
		margin: 0.75rem 0 0;
		color: var(--muted);
	}
	.criteria {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 0;
	}
	.criteria div {
		padding: 0.5rem 0.9rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}
	.criteria dd {
		margin: 0;
		font-family: var(--font-mono);
		font-weight: 700;
	}
	.fallback {
		margin: 0;
		font-style: italic;
	}
</style>
