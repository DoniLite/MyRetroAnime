---
import YearLine from "../../../components/YearLine.astro";
import Base from "../../../layouts/Base.astro";
import { getAnimeOfYear } from "../../../lib/anime";
import { LANGS, type Lang } from "../../../lib/i18n";
import { getYear, years } from "../../../years";

export function getStaticPaths() {
	return LANGS.flatMap((lang) =>
		years.map(({ year }) => ({ params: { lang, year: String(year) } })),
	);
}

const lang = Astro.params.lang as Lang;
const year = Number(Astro.params.year);
const { config } = getYear(year);
const anime = await getAnimeOfYear(year, lang);
---

<Base
	lang={lang}
	title={`${config.title[lang]} · ${year} · MyRetroAnime`}
	description={config.tagline[lang]}
	path={`${year}/`}
	theme={config.theme}
>
	<YearLine lang={lang} year={year} config={config} anime={anime} />
</Base>
