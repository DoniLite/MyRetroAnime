---
import YearLine from "../../../components/YearLine.astro";
import Base from "../../../layouts/Base.astro";
import { getAnimeOfYear } from "../../../lib/anime";
import { LANGS } from "../../../lib/i18n";
import { getYear, years } from "../../../years";

// Same line as the year page, opened at this station: real URL for previews and SEO.
export async function getStaticPaths() {
	const paths = [];
	for (const lang of LANGS) {
		for (const { year } of years) {
			const line = await getAnimeOfYear(year, lang);
			for (const anime of line) {
				paths.push({
					params: { lang, year: String(year), anime: anime.slug },
					props: { lang, anime, line },
				});
			}
		}
	}
	return paths;
}

const { lang, anime, line } = Astro.props;
const { config } = getYear(anime.year);
const description = anime.text?.entry.data.pitch ?? config.tagline[lang];
---

<Base
	lang={lang}
	title={`${anime.info.title} · ${anime.year} · MyRetroAnime`}
	description={description}
	path={`${anime.year}/${anime.slug}/`}
	theme={config.theme}
>
	<YearLine lang={lang} year={anime.year} config={config} anime={line} open={anime.slug} />
</Base>
